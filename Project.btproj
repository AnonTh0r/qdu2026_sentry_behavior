<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="src/qdu2026_sentry_behavior/behavior_trees/weilaibei.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Condition ID="IsGameStatus" editable="true">
            <input_port name="expected_game_progress"/>
            <input_port name="key_port"/>
        </Condition>
        <Condition ID="IsHpLow" editable="true">
            <input_port name="hp_threshold"/>
            <input_port name="key_port"/>
        </Condition>
        <Condition ID="IsStatusOK" editable="true">
            <input_port name="hp_min"/>
            <input_port name="key_port"/>
        </Condition>
        <Condition ID="PubNav2Goal" editable="true">
            <input_port name="goal"/>
            <input_port name="topic_name"/>
        </Condition>
        <Condition ID="WaitUntilReached" editable="true">
            <input_port name="goal"/>
            <input_port name="odom"/>
            <input_port name="tolerance"/>
        </Condition>
    </TreeNodesModel>
</root>
