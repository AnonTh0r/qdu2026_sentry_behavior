<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="test_navigation_spin">
    <Sequence>
      <!-- 等待比赛开始 -->
      <RetryUntilSuccessful num_attempts="-1">
        <IsGameStatus max_remain_time="420"
                      min_remain_time="0"
                      expected_game_progress="4"
                      key_port="{@referee_gameStatus}"/>
      </RetryUntilSuccessful>

      <!-- 主循环 -->
      <KeepRunningUntilFailure>
        <Parallel success_count="1"
                  failure_count="2">

          <!-- 被动：受击时加速旋转，不影响导航 -->
          <ReactiveFallback>
            <Sequence>
              <IsHpDropping hp_drop_threshold="10"
                            key_port="{@referee_robotStatus}"/>
              <PublishSpinSpeed spin_speed="5.0"
                                topic_name="/cmd_spin"/>
            </Sequence>
            <PublishSpinSpeed spin_speed="2.0"
                              topic_name="/cmd_spin"/>
          </ReactiveFallback>

          <!-- 导航主逻辑 -->
          <ReactiveFallback>
            <!-- 优先级1：HP低 → 回家回血 -->
            <Sequence>
              <Inverter>
                <IsStatusOK hp_min="200"
                            key_port="{@referee_robotStatus}"/>
              </Inverter>
              <NavigateThroughPoses waypoint_file="/home/navii/code/qdu2026_behavior_rmul/src/qdu2026_sentry_behavior/behavior_trees/home.csv"
                                    frame_id="map"
                                    action_name="navigate_through_poses"/>
              <StayHome hp_min="350"
                        key_port="{@referee_robotStatus}"/>
            </Sequence>

            <!-- 优先级2：HP正常 → 巡逻 -->
            <Repeat num_cycles="-1">
              <NavigateThroughPoses waypoint_file="/home/navii/code/qdu2026_behavior_rmul/src/qdu2026_sentry_behavior/behavior_trees/patrol.csv"
                                    frame_id="map"
                                    action_name="navigate_through_poses"/>
            </Repeat>

            <!-- 兜底 -->
            <AlwaysSuccess/>
          </ReactiveFallback>

        </Parallel>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsGameStatus"
            editable="true">
      <input_port name="max_remain_time"/>
      <input_port name="min_remain_time"/>
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Action>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="StayHome"
               editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsHpDropping"
               editable="true">
      <input_port name="hp_drop_threshold"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PublishSpinSpeed"
            editable="true">
      <input_port name="spin_speed"/>
      <input_port name="topic_name"/>
    </Action>
    <Action ID="NavigateThroughPoses"
            editable="true">
      <input_port name="waypoint_file"/>
      <input_port name="frame_id"/>
      <input_port name="action_name"/>
      <output_port name="current_waypoint"/>
    </Action>
  </TreeNodesModel>

</root>