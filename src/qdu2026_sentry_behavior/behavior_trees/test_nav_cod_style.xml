<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="test_nav_cod_style">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <IsGameStatus expected_game_progress="4"
                      key_port="{@referee_gameStatus}"/>
      </RetryUntilSuccessful>
      <KeepRunningUntilFailure>
        <ReactiveFallback>
          <Sequence>
            <IsHpLow hp_threshold="200"
                     key_port="{@referee_robotStatus}"/>
            <ReactiveSequence>
              <PubNav2Goal goal="0.0;0.0;0.0"
                           topic_name="goal_pose"/>
              <WaitUntilReached goal="0.0;0.0;0.0"
                                odom="{@odom}"
                                tolerance="0.5"/>
            </ReactiveSequence>
            <StayHome hp_min="350"
                      key_port="{@referee_robotStatus}"/>
          </Sequence>
          <ReactiveSequence>
            <PubNav2Goal goal="2.0;2.0;0.0"
                         topic_name="goal_pose"/>
            <WaitUntilReached goal="2.0;2.0;0.0"
                              odom="{@odom}"
                              tolerance="0.5"/>
          </ReactiveSequence>
          <ReactiveSequence>
            <PubNav2Goal goal="4.0;4.0;0.0"
                         topic_name="goal_pose"/>
            <WaitUntilReached goal="4.0;4.0;0.0"
                              odom="{@odom}"
                              tolerance="0.5"/>
          </ReactiveSequence>
          <AlwaysSuccess/>
        </ReactiveFallback>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsHpLow"
               editable="true">
      <input_port name="hp_threshold"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="PubNav2Goal"
               editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Condition>
    <Condition ID="StayHome"
               editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="WaitUntilReached"
               editable="true">
      <input_port name="goal"/>
      <input_port name="odom"/>
      <input_port name="tolerance"/>
    </Condition>
  </TreeNodesModel>

</root>
