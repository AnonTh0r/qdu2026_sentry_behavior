<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="jiudian">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <Fallback>
          <Sequence>
                        hp_min="400"
                        key_port="{@referee_robotStatus}"/>
            <PubNav2Goal goal="1.62;-7.12;0"
                         topic_name="goal_pose"/>
            <Sleep msec="10000"/>
            <PubNav2Goal goal="1.62;-7.12;0"
                         topic_name="goal_pose"/>
            <Sleep msec="10000"/>
            <PubNav2Goal goal="1.62;-7.12;0"
                         topic_name="goal_pose"/>
            <Sleep msec="4000"/>
          </Sequence>
          <Sequence>
                        hp_min="150"
                        key_port="{@referee_robotStatus}"/>
            <PubNav2Goal goal="1.1;0.44;0"
                         topic_name="goal_pose"/>
            <Sleep msec="10000"/>
            <PubNav2Goal goal="1.1;0.44;0"
                         topic_name="goal_pose"/>
            <Sleep msec="10000"/>
            <PubNav2Goal goal="1.1;0.44;0"
                         topic_name="goal_pose"/>
          </Sequence>
          <PubNav2Goal goal="5.22;10.16;0"
                       topic_name="goal_pose"/>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
