<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="blue_fixed">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <IsGameStatus max_remain_time="420"
                      min_remain_time="0"
                      expected_game_progress="4"
                      key_port="{@referee_gameStatus}"/>
      </RetryUntilSuccessful>
      <Repeat num_cycles="-1">
        <Fallback>
          <ReactiveSequence>
            <IsStatusOK hp_min="150"
                        key_port="{@referee_robotStatus}"/>
            <Sequence>
              <!-- 第一个点：持续发布直到超时 -->
              <ReactiveSequence>
                <PubNav2Goal goal="5.30;0.31;0"
                             topic_name="goal_pose"/>
                <Sleep msec="5000"/>
              </ReactiveSequence>

              <!-- 第二个点：持续发布直到超时 -->
              <ReactiveSequence>
                <PubNav2Goal goal="4.99;4.97;0"
                             topic_name="goal_pose"/>
                <Sleep msec="5000"/>
              </ReactiveSequence>

              <!-- 第三个点：持续发布直到超时 -->
              <ReactiveSequence>
                <PubNav2Goal goal="2.12;5.00;0"
                             topic_name="goal_pose"/>
                <Sleep msec="120000"/>
              </ReactiveSequence>
            </Sequence>
          </ReactiveSequence>
          <RetryUntilSuccessful num_attempts="-1">
            <Sequence>
              <PubNav2Goal goal="5.22;10.16;0"
                           topic_name="goal_pose"/>
              <Sleep msec="3000"/>
              <IsStatusOK hp_min="400"
                          key_port="{@referee_robotStatus}"/>
            </Sequence>
          </RetryUntilSuccessful>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>
