<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="test_outpost_destroyed">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <PubNav2Goal goal="0.7;1.74;0"
                     topic_name="goal_pose"/>
        <ChangePose topic_name="/referee/set_pose"
                    current_pose="1"/>
        <Sleep msec="100"/>
        <ReactiveFallback>
          <!-- 分支1: 前哨站被摧毁 — 驻守防御点，血低回血再回来 -->
          <ReactiveSequence>
            <IsOutpostDestroyed hp_threshold="0"
                                team="blue"
                                key_port="{@referee_allRobotHP}"/>
            <KeepRunningUntilFailure>
              <ReactiveFallback>
                <!-- 血量低: 回家补血，补满后 Sequence 返回 SUCCESS，KeepRunning 重启 -->
                <Sequence>
                  <IsHpLow hp_threshold="390"
                           key_port="{@referee_robotStatus}"/>
                  <ChangePose topic_name="/referee/set_pose"
                              current_pose="3"/>
                  <PubNav2Goal goal="0;0;0"
                               topic_name="goal_pose"/>
                  <WaitUntilReached/>
                  <StayHome hp_min="391"
                            key_port="{@referee_robotStatus}"/>
                </Sequence>
                <!-- 血量正常: 前往/驻守防御点 -->
                <Sequence>
                  <ChangePose topic_name="/referee/set_pose"
                              current_pose="2"/>
                  <PubNav2Goal goal="0;0;0"
                               topic_name="goal_pose"/>
                  <WaitUntilReached/>
                  <Sleep msec="500"/>
                </Sequence>
              </ReactiveFallback>
            </KeepRunningUntilFailure>
          </ReactiveSequence>
          <!-- 分支2: 前哨站存活 — 正常巡逻 -->
          <KeepRunningUntilFailure>
            <Sequence>
              <PubNav2Goal goal="2;1.74;0"
                           topic_name="goal_pose"/>
              <WaitUntilReached/>
              <ChangePose topic_name="/referee/set_pose"
                          current_pose="2"/>
              <PubNav2Goal goal="-1.2;1.74;0"
                           topic_name="goal_pose"/>
              <WaitUntilReached/>
            </Sequence>
          </KeepRunningUntilFailure>
        </ReactiveFallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChangePose">
      <input_port name="topic_name"
                  default="/referee/set_pose"
                  type="std::string">Topic name</input_port>
      <input_port name="current_pose"
                  default="1"
                  type="int">Pose mode (1: patrol, 2: attack, 3: defence)</input_port>
    </Action>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsHpLow"
               editable="true">
      <input_port name="hp_threshold"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsOutpostDestroyed"
               editable="true">
      <input_port name="hp_threshold"/>
      <input_port name="team"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
    <Condition ID="StayHome"
               editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="WaitUntilReached"/>
  </TreeNodesModel>

</root>
