<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="red_fixed">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus max_remain_time="420"
                        min_remain_time="0"
                        expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <ForceSuccess>
          <Fallback>
            <ReactiveSequence>
                          hp_min="150"
                          key_port="{@referee_robotStatus}"/>
              <!-- 持续发布第一个点 -->
              <ReactiveSequence>
                <PubNav2Goal goal="2.16;5.07;0"
                             topic_name="goal_pose"/>
                <Sleep msec="231000"/>
              </ReactiveSequence>
            </ReactiveSequence>
            <RetryUntilSuccessful num_attempts="-1">
              <Sequence>
                <PubNav2Goal goal="5.22;10.16;0"
                             topic_name="goal_pose"/>
                <Sleep msec="3000"/>
                            hp_min="400"
                            key_port="{@referee_robotStatus}"/>
              </Sequence>
            </RetryUntilSuccessful>
          </Fallback>
        </ForceSuccess>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
