<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="rmul_2026">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <Parallel success_count="1" failure_count="1">
          <PublishSpinSpeed spin_speed="0.3"
                            topic_name="cmd_spin"/>
          <Fallback>
          <ReactiveSequence>
                        hp_min="390"
                        key_port="{@referee_robotStatus}"/>
            <Sequence>
              <PubNav2Goal goal="2;3;0"
                           topic_name="goal_pose"/>
              <Sleep msec="15000"/>
              <PubNav2Goal goal="1;1;0"
                           topic_name="goal_pose"/>
              <Sleep msec="15000"/>
            </Sequence>
          </ReactiveSequence>
          <Sequence>
            <Sleep msec="1000"/>
            <PubNav2Goal goal="3;0;0"
                         topic_name="goal_pose"/>
          </Sequence>
        </Fallback>
        </Parallel>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
    <Action ID="PublishSpinSpeed"
            editable="true">
      <input_port name="spin_speed"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
