<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="rmuc">
    <KeepRunningUntilFailure>
      <Sequence>

        <!-- 等比赛开始 -->
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>

        <!-- 导航到巡逻区间入口（一次性，独立于巡逻和回家逻辑） -->
        <PubNav2Goal goal="0.0;-4.0;0" topic_name="goal_pose"/>
        <WaitUntilReached tolerance="0.5" odom="{@odom}" goal="0.0;-4.0;0"/>

        <!-- ReactiveFallback: 每个 tick 都先检查 HP，确保随时可打断巡逻 -->
        <ReactiveFallback>

          <!-- 优先级1: HP低 → 回家 → 等回血 -->
          <Sequence>
            <IsHpLow hp_threshold="200"
                     key_port="{@referee_robotStatus}"/>
            <PubNav2Goal goal="1.1;0.44;0"
                         topic_name="goal_pose"/>
            <WaitUntilReached tolerance="0.5"
                              odom="{@odom}"
                              goal="1.1;0.44;0"/>
            <StayHome hp_min="350"
                      key_port="{@referee_robotStatus}"/>
          </Sequence>

          <!-- 优先级2: 巡逻循环 -->
          <KeepRunningUntilFailure>
            <Sequence>
              <PubNav2Goal goal="1.62;-7.12;0" topic_name="goal_pose"/>
              <WaitUntilReached tolerance="0.5" odom="{@odom}" goal="1.62;-7.12;0"/>

              <PubNav2Goal goal="0.06;-0.06;0" topic_name="goal_pose"/>
              <WaitUntilReached tolerance="0.5" odom="{@odom}" goal="0.06;-0.06;0"/>

              <PubNav2Goal goal="-2.31;0.77;0" topic_name="goal_pose"/>
              <WaitUntilReached tolerance="0.5" odom="{@odom}" goal="-2.31;0.77;0"/>
            </Sequence>
          </KeepRunningUntilFailure>

        </ReactiveFallback>

      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="IsGameStatus" editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsHpLow" editable="true">
      <input_port name="hp_threshold"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal" editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
    <Condition ID="WaitUntilReached">
      <input_port name="tolerance" default="0.500000" type="double"/>
      <input_port name="odom" default="{@odom}"/>
      <input_port name="goal" type="std::string"/>
    </Condition>
    <Condition ID="StayHome" editable="true">
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
  </TreeNodesModel>
</root>
