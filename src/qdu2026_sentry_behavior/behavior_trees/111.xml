<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="patrol111">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <Fallback>
          <ReactiveSequence>
            <Inverter>
                          hp_min="79"
                          key_port="{@referee_robotStatus}"/>
            </Inverter>
            <KeepRunningUntilFailure>
              <Sequence>
                <PubNav2Goal goal="0;0;0"
                             topic_name="goal_pose"/>
                <Sleep msec="15000"/>
              </Sequence>
            </KeepRunningUntilFailure>
          </ReactiveSequence>
          <Sequence>
            <ReactiveSequence>
                          hp_min="200"
                          key_port="{@referee_robotStatus}"/>
              <Sequence>
                <PubNav2Goal goal="0;0;0"
                             topic_name="goal_pose"/>
                <Sleep msec="2000"/>
              </Sequence>
            </ReactiveSequence>
            <ReactiveSequence>
                          hp_min="200"
                          key_port="{@referee_robotStatus}"/>
              <Sequence>
                <PubNav2Goal goal="4.76;0.07;0"
                             topic_name="goal_pose"/>
                <Sleep msec="3000"/>
              </Sequence>
            </ReactiveSequence>
            <ReactiveSequence>
                          hp_min="200"
                          key_port="{@referee_robotStatus}"/>
              <Sequence>
                <PubNav2Goal goal="0.84;5.35;0"
                             topic_name="goal_pose"/>
                <Sleep msec="8000"/>
              </Sequence>
            </ReactiveSequence>
            <ReactiveSequence>
                          hp_min="200"
                          key_port="{@referee_robotStatus}"/>
              <Sequence>
                <PubNav2Goal goal="4;4;0"
                             topic_name="goal_pose"/>
                <Sleep msec="1000"/>
              </Sequence>
              <AlwaysSuccess/>
            </ReactiveSequence>
          </Sequence>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
