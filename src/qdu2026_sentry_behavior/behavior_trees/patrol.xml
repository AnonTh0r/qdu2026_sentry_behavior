<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="patrol">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <ChangePose current_pose="1"
                    topic_name="/referee/set_pose"/>
        <PublishSpinSpeed spin_speed="0.3"
                          duration="100"
                          topic_name="cmd_spin"/>
        <Fallback>
          <ReactiveSequence>
            <IsStatusOK ammo_min="0"
                        heat_max="350"
                        hp_min="590"
                        key_port="{@referee_robotStatus}"/>
            <Sequence>
              <ChangePose current_pose="2"
                          topic_name="/referee/set_pose"/>
              <Sleep msec="15000"/>
              <Sleep msec="15000"/>
            </Sequence>
          </ReactiveSequence>
          <Sequence>
            <ChangePose current_pose="3"
                        topic_name="/referee/set_pose"/>
            <PublishSpinSpeed spin_speed="0.3"
                              duration="10"
                              topic_name="cmd_spin"/>
            <Sleep msec="1000"/>
          </Sequence>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChangePose"
            editable="true">
      <input_port name="current_pose"/>
      <input_port name="topic_name"/>
    </Action>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PublishSpinSpeed"
            editable="true">
      <input_port name="spin_speed"/>
      <input_port name="duration"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
