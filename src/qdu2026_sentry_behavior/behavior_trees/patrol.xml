<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="patrol">
    <KeepRunningUntilFailure>
      <Sequence>
        <RetryUntilSuccessful num_attempts="-1">
          <IsGameStatus expected_game_progress="4"
                        key_port="{@referee_gameStatus}"/>
        </RetryUntilSuccessful>
        <ChangePose topic_name="/referee/set_pose"
                    current_pose="1"/>
        <Fallback>
          <ReactiveSequence>
            <Sequence>
              <PubNav2Goal goal="-2.31;0.77;0"
                           topic_name="goal_pose"/>
              <Sleep msec="8000"/>
              <PubNav2Goal goal="-4;0.81;0"
                           topic_name="goal_pose"/>
              <Sleep msec="5000"/>
              <ChangePose topic_name="/referee/set_pose"
                          current_pose="2"/>
              <PubNav2Goal goal="-6;0.8;0"
                           topic_name="goal_pose"/>
              <Sleep msec="8000"/>
              <PubNav2Goal goal="-10.31;1.58;0"
                           topic_name="goal_pose"/>
              <Sleep msec="8000"/>
              <ChangePose topic_name="/referee/set_pose"
                          current_pose="1"/>
              <PubNav2Goal goal="7.29;-0.89;0"
                           topic_name="goal_pose"/>
              <Sleep msec="20000"/>
              <PubNav2Goal goal="8.49;-4.62;0"
                           topic_name="goal_pose"/>
              <Sleep msec="20000"/>
            </Sequence>
          </ReactiveSequence>
                      hp_min="590"
                      key_port="{@referee_robotStatus}"/>
          <Sequence>
            <ChangePose topic_name="/referee/set_pose"
                        current_pose="3"/>
            <PublishSpinSpeed spin_speed="0.3"
                              topic_name="cmd_spin"/>
            <Sleep msec="1000"/>
            <PubNav2Goal goal="3;0;0"
                         topic_name="goal_pose"/>
          </Sequence>
        </Fallback>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChangePose">
      <input_port name="topic_name"
                  default="/referee/set_pose"
                  type="std::string">Topic name</input_port>
      <input_port name="current_pose"
                  default="1"
                  type="int">Pose mode (1: patrol, 2: attack, 3: defence)</input_port>
    </Action>
    <Condition ID="IsGameStatus"
               editable="true">
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Condition>
    <Condition ID="IsStatusOK"
               editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Condition>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
    <Action ID="PublishSpinSpeed"
            editable="true">
      <input_port name="spin_speed"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
