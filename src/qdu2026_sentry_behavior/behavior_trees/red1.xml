          <RetryUntilSuccessful num_attempts="-1">
            <Sequence>
              <PubNav2Goal goal="8.82;-3.54;0"
                           topic_name="goal_pose"/>
              <Sleep msec="4000"/>
              <PubNav2Goal goal="8.9;0.29;0"
                           topic_name="goal_pose"/>
              <Sleep msec="4000"/>
              <PubNav2Goal goal="0;0;0"
                           topic_name="goal_pose"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
              <Sleep msec="6000"/>
                          hp_min="400"
                          key_port="{@referee_robotStatus}"/>
            </Sequence>
          </RetryUntilSuccessful>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsGameStatus"
            editable="true">
      <input_port name="max_remain_time"/>
      <input_port name="min_remain_time"/>
      <input_port name="expected_game_progress"/>
      <input_port name="key_port"/>
    </Action>
    <Action ID="IsStatusOK"
            editable="true">
      <input_port name="ammo_min"/>
      <input_port name="heat_max"/>
      <input_port name="hp_min"/>
      <input_port name="key_port"/>
    </Action>
    <Action ID="PubNav2Goal"
            editable="true">
      <input_port name="goal"/>
      <input_port name="topic_name"/>
    </Action>
  </TreeNodesModel>

</root>
